# Clause application settings
# Copy this file to .env and add your own provider credentials.
# Never commit .env or real API keys.

RAG_APP_NAME=Clause
RAG_DATA_PATH=files/shop_handbook.pdf

# Chat model
RAG_CHAT_PROVIDER=google_genai
RAG_CHAT_TEMPERATURE=0.1
RAG_CHAT_MODEL=gemini-3.5-flash-lite
RAG_GOOGLE_API_KEY=

# Embedding model
# Keep the EMBEDED spelling aligned with the current config.py field names.
RAG_EMBEDED_PROVIDER=ollama
RAG_EMBEDED_MODEL=nomic-embed-text:latest
RAG_EMBEDED_DIM=768

# Chunking and retrieval
RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=3
RAG_THRESHOLD_SCORE=0

# Qdrant
RAG_COLLECTION=shop_handbook
RAG_QDRANT_DATA=./vector_stores
RAG_QDRANT_URL=
